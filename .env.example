# ==============================================================================
# AntiDeepFake - Environment Configuration Template
# ==============================================================================

# 1. Application and Server Settings
APP_ENV=development
PROVIDER_MODE=offline
PROVIDER_TIMEOUT_SEC=10
REPOSITORY_BACKEND=memory
SQLITE_PATH=analysis.sqlite3
TEMP_ROOT=
APP_ORIGIN=http://127.0.0.1:3000
API_PORT=8000

# 2. Computer Vision - Deepfake Detection (Sightengine REST API + Optional HF Fallback)
# Sign up at: https://dashboard.sightengine.com/signup (2,000 free requests/month, 1 req/s)
SIGHTENGINE_API_USER=your_sightengine_user
SIGHTENGINE_API_SECRET=your_sightengine_secret
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json
# Optional free fallback (Hugging Face Serverless Inference: prithivMLmods/Deepfake-Detect-Siglip2)
HF_TOKEN=
HF_DEEPFAKE_URL=

# 3. Audio & STT - Google Serverless API (Files API + Interactions API)
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_STT_FALLBACK_MODEL=gemini-2.5-flash

# 4. Decision Model - OpenRouter Decisions API (Perplexity Decider System One)
# Get your API key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DECIDER_API_URL=https://openrouter.ai/api/alpha/decisions
DECIDER_MODEL=perplexity/pplx-decider-flash-v1.3:free

# 5. Evaluation Window & Rate Guard Settings
ANALYSIS_WINDOW_SECONDS=5
KEYFRAMES_PER_WINDOW=1
SIGHTENGINE_MIN_INTERVAL_SEC=1.1
CV_DEEPFAKE_THRESHOLD=0.60
VERBAL_PRESSURE_THRESHOLD=0.70

# 6. Supabase (PostgreSQL IPv4 Pooler Port 6543 + Storage)
# Use Supavisor IPv4 pooler URI on Render (avoid IPv6 port 5432 failures)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_or_anon_key
