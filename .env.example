# ==============================================================================
# AntiDeepFake - Environment Configuration Template
# ==============================================================================

# 1. Application and Server Settings
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
API_PORT=8000

# 2. Computer Vision - Deepfake Detection (Sightengine REST API)
# Sign up at: https://dashboard.sightengine.com/signup (2,000 free requests/month)
SIGHTENGINE_API_USER=your_sightengine_user
SIGHTENGINE_API_SECRET=your_sightengine_secret
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json

# 3. Audio & NLP - Google Serverless API
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_VISION_MODEL=gemini-3.8-flash

# 4. Decision Model - OpenRouter API (Perplexity Decider System One)
# Get your API key at: https://openrouter.ai/ (Free model)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DECIDER_MODEL=perplexity/pplx-decider-flash-v1.3:free

# 5. Evaluation Window Settings (Progressive 5-Second Window)
ANALYSIS_WINDOW_SECONDS=5
CV_DEEPFAKE_THRESHOLD=0.60
VERBAL_PRESSURE_THRESHOLD=0.70

# 6. Google OAuth (Optional) & Session Security
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
AUTH_SESSION_SECRET=your_random_32_character_secret_key

# 7. Database (PostgreSQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=antideepfake_dev
DATABASE_USER=antideepfake
DATABASE_PASSWORD=your_database_password
